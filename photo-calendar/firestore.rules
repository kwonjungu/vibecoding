rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 바이브코딩 7칸: 날짜별 사진 캘린더 규칙
    // 익명 로그인(request.auth != null)을 통한 읽기/쓰기 허용
    match /calendar_photos/{dateId} {
      allow read: if true; // 누구나 달력 사진 조회 가능
      allow write: if request.auth != null; // 익명 로그인된 사용자만 업로드/수정/삭제 가능
    }

  }
}
